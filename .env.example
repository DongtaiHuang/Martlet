# Supabase (leave empty to run in mock mode). See docs/SUPABASE_SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=

# Only for `node --env-file=.env.local supabase/verify.mjs` (never commit real values).
MARTLET_TEST_A_EMAIL=
MARTLET_TEST_A_PASSWORD=
MARTLET_TEST_B_EMAIL=
MARTLET_TEST_B_PASSWORD=

# Optional Google Maps integration. The browser key is public and referrer-restricted.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Reserved for server-side Places verification. Never prefix this with NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=
